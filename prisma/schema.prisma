generator client {
  output          = "generated"
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
  extensions      = [uuidOssp(map: "uuid-ossp")]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

// auth models
model Account {
  id                String  @id @default(cuid())
  userId            String  @unique
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
  @@schema("auth")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamp()
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("auth")
}

model User {
  id        String    @id @default(cuid())
  document  String    @unique
  name      String
  email     String    @unique
  password  String
  isActive  Boolean   @default(false) @db.Boolean
  image     String?
  createdAt DateTime  @default(now()) @db.Timestamp()
  deletedAt DateTime? @db.Timestamp()

  announcements Announcement[]
  roles         Role[]
  sessions      Session[]
  account       Account?

  @@map("user")
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  createdAt  DateTime @default(now()) @db.Timestamp()
  issuer     String   @db.VarChar(75) // ACTIVATION_TOKEN | RECOVERY_PASSWORD_TOKEN

  @@unique([identifier, token])
  @@map("verification_token")
  @@schema("auth")
}

model Role {
  id          String  @id @default(cuid())
  userId      String?
  name        String  @db.VarChar(15)
  description String? @db.VarChar(75)
  user        User?   @relation(fields: [userId], references: [id])

  @@map("role")
  @@schema("auth")
}

// announcement models

enum AnnouncementStatus {
  APROVED
  PENDENT
  REPROVED

  @@schema("public")
}

model Announcement {
  id                  String  @id @default(cuid())
  title               String? @db.VarChar()
  type                String  @db.VarChar()
  ownerFullName       String  @db.VarChar()
  ownerDocument       String  @db.VarChar()
  lawSuit             String  @db.VarChar()
  court               String  @db.VarChar()
  origin              String  @db.VarChar()
  price               Decimal @db.Decimal()
  salePrice           Decimal @db.Decimal()
  liquidBalance       Decimal @db.Decimal()
  paymentOption       String  @db.VarChar()
  pixKey              String? @db.VarChar()
  ownerBankAccount    String? @db.VarChar()
  documentBankAccount String? @db.VarChar()
  bankAccount         String? @db.VarChar()
  agencyBankAccount   String? @db.VarChar()

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status    AnnouncementStatus @default(PENDENT)
  createdAt DateTime           @default(now()) @db.Timestamp()
  deletedAt DateTime?          @db.Timestamp()

  @@map("announcement")
  @@schema("public")
}
